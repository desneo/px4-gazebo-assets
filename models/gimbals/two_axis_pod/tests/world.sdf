        <command_topic>/two_axis_pod/command</command_topic>
        <telemetry_topic>/two_axis_pod/telemetry</telemetry_topic>
        <command_result_topic>/two_axis_pod/command_result</command_result_topic>
        <control_rate>100</control_rate>
        <telemetry_rate>50</telemetry_rate>
        <max_rate_dps>100</max_rate_dps>
        <max_acc_dps2>160</max_acc_dps2>
        <yaw_min_deg>-90</yaw_min_deg>
        <yaw_max_deg>90</yaw_max_deg>
        <pitch_min_deg>-45</pitch_min_deg>
        <pitch_max_deg>90</pitch_max_deg>
