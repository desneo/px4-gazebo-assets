<?xml version="1.0"?>
<sdf version="1.9">
  <world name="two_axis_pod_demo">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
    <gravity>0 0 -9.8</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.65 0.75 0.85 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><direction>-0.5 0.3 -1</direction><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.3 0.3 0.3 1</specular></light>
    <model name="ground"><static>true</static><link name="link"><collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual></link></model>
    <model name="fixture"><static>true</static><pose>0 0 0.75 0 0 0</pose><link name="link"><visual name="pedestal"><geometry><box><size>0.18 0.18 1.5</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual></link></model>
    <model name="tracking_target"><static>true</static><pose>0.015 0 4 0 0 0</pose><link name="link"><visual name="panel"><geometry><box><size>0.65 0.65 0.01</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="overview"><static>true</static><pose>0.215 -0.235 1.65 0 0.38 2.25</pose><link name="link"><sensor name="overview" type="camera"><always_on>true</always_on><update_rate>5</update_rate><topic>/two_axis_pod/overview</topic><camera><horizontal_fov>0.65</horizontal_fov><image><width>960</width><height>720</height><format>R8G8B8</format></image><clip><near>0.005</near><far>50</far></clip></camera></sensor></link></model>
  </world>
</sdf>
