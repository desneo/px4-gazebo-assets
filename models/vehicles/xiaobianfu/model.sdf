<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="xiaobianfu">
    <link name="base_link">
      <inertial>
        <mass>0.984</mass>
        <inertia>
          <ixx>0.045</ixx>
          <iyy>0.009</iyy>
          <izz>0.051</izz>
