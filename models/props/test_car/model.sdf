<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="test_car">
    <static>false</static>
    <pose>0 25 0.55 0 0 0</pose>

    <link name="base">
      <inertial>
        <pose>0 0 -0.2 0 0 0</pose>
        <mass>60</mass>
        <inertia>
          <ixx>20</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>50</iyy>
          <iyz>0</iyz>
          <izz>60</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box><size>3.0 1.6 0.7</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="body_visual">
        <geometry>
          <box><size>3.0 1.6 0.7</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.12 0.10 1</ambient>
          <diffuse>0.85 0.12 0.10 1</diffuse>
        </material>
      </visual>

      <!-- 顶部白色底板 + 深色棋盘块：保证选框内有足够纹理 -->
      <visual name="roof_base">
        <pose>0 0 0.36 0 0 0</pose>
        <geometry>
          <box><size>2.6 1.2 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>
      <visual name="roof_tile_0">
        <pose>-0.9 0.3 0.38 0 0 0</pose>
        <geometry><box><size>0.55 0.55 0.03</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="roof_tile_1">
        <pose>-0.3 -0.3 0.38 0 0 0</pose>
        <geometry><box><size>0.55 0.55 0.03</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="roof_tile_2">
        <pose>0.3 0.3 0.38 0 0 0</pose>
        <geometry><box><size>0.55 0.55 0.03</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="roof_tile_3">
        <pose>0.9 -0.3 0.38 0 0 0</pose>
        <geometry><box><size>0.55 0.55 0.03</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>

      <!-- 车轮（视觉） -->
      <visual name="wheel_fl">
        <pose>0.95 0.85 -0.25 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.3</radius><length>0.24</length></cylinder></geometry>
        <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material>
      </visual>
      <visual name="wheel_fr">
        <pose>0.95 -0.85 -0.25 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.3</radius><length>0.24</length></cylinder></geometry>
        <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material>
      </visual>
      <visual name="wheel_rl">
        <pose>-0.95 0.85 -0.25 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.3</radius><length>0.24</length></cylinder></geometry>
        <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material>
      </visual>
      <visual name="wheel_rr">
        <pose>-0.95 -0.85 -0.25 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.3</radius><length>0.24</length></cylinder></geometry>
        <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material>
      </visual>
    </link>

    <!-- 速度控制：通过 /model/test_car/cmd_vel 话题驱动 -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/test_car/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
