    <joint name="yaw_joint" type="revolute">
      <parent>mount_link</parent>
      <child>yaw_arm_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.0471975512</lower>
          <upper>1.0471975512</upper>
          <effort>5</effort>
          <velocity>1.0471975512</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="pitch_joint" type="revolute">
      <parent>yaw_arm_link</parent>
      <child>camera_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1.3962634016</lower>
          <upper>0.523598775598</upper>
          <effort>5</effort>
          <velocity>1.0471975512</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-aisheng-seeker-controller" name="two_axis::GimbalController">
      <yaw_joint>yaw_joint</yaw_joint>
      <pitch_joint>pitch_joint</pitch_joint>
      <mount_link>mount_link</mount_link>
      <camera_link>camera_link</camera_link>
      <camera_sensor>camera</camera_sensor>
      <mount_mode>upright</mount_mode>
      <command_topic>/aisheng_seeker/command</command_topic>
      <telemetry_topic>/aisheng_seeker/telemetry</telemetry_topic>
      <command_result_topic>/aisheng_seeker/command_result</command_result_topic>
      <image_topic>/aisheng_seeker/camera</image_topic>
      <control_rate>100</control_rate>
      <tracking_backend>sim_truth</tracking_backend>
      <telemetry_config>model://aisheng-ASD-2-075-DD0/controller/service/telemetry.json</telemetry_config>
      <max_rate_dps>60</max_rate_dps>
      <max_acc_dps2>160</max_acc_dps2>
      <kp>6</kp>
      <yaw_min_deg>-60</yaw_min_deg>
      <yaw_max_deg>60</yaw_max_deg>
      <pitch_min_deg>-80</pitch_min_deg>
      <pitch_max_deg>30</pitch_max_deg>
      <los_observer_cg_model>0 0 0</los_observer_cg_model>
      <sim_truth_target_name>target_aircraft</sim_truth_target_name>
      <sim_truth_target_name>target_aircraft_2</sim_truth_target_name>
    </plugin>
