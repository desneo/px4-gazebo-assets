<?xml version="1.0"?>
<sdf version="1.9">
  <model name="three_axis_pod_stand">
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- 朝天三轴吊舱：安装在 1.5m 高处 -->
    <include merge="true">
      <uri>model://three_axis_pod</uri>
      <pose>0 0 1.5 0 0 0</pose>
    </include>

    <!-- 厚重底座：靠重力与摩擦固定在原点 -->
    <link name="stand_base">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>30</mass>
        <inertia>
          <ixx>1.625</ixx>
          <iyy>1.625</iyy>
          <izz>3.2</izz>
        </inertia>
      </inertial>
      <collision name="stand_base_collision">
        <geometry>
          <box><size>0.8 0.8 0.1</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="stand_base_visual">
        <geometry>
          <box><size>0.8 0.8 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 立柱视觉（细杆，从底座到吊舱底座） -->
    <link name="stand_mast">
      <pose>0 0 0.775 0 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.402</ixx>
          <iyy>0.402</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name="stand_mast_collision">
        <geometry>
          <cylinder><radius>0.04</radius><length>1.45</length></cylinder>
        </geometry>
      </collision>
      <visual name="stand_mast_visual">
        <geometry>
          <cylinder><radius>0.04</radius><length>1.45</length></cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="stand_mast_joint" type="fixed">
      <parent>stand_base</parent>
      <child>stand_mast</child>
    </joint>

    <joint name="stand_attach_joint" type="fixed">
      <parent>stand_mast</parent>
      <child>cgo3_mount_link</child>
    </joint>
  </model>
</sdf>
