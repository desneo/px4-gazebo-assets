    <joint name="yaw_joint" type="revolute">
      <parent>mount_link</parent>
      <child>yaw_arm_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.5707963267948966</lower>
          <upper>1.5707963267948966</upper>
          <effort>5</effort>
          <velocity>1.7453292519943295</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="pitch_joint" type="revolute">
      <parent>yaw_arm_link</parent>
      <child>camera_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.7853981633974483</lower>
          <upper>1.5707963267948966</upper>
          <effort>5</effort>
          <velocity>1.7453292519943295</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-two-axis-pod-controller" name="two_axis::GimbalController">
      <yaw_joint>yaw_joint</yaw_joint>
      <pitch_joint>pitch_joint</pitch_joint>
      <mount_link>mount_link</mount_link>
      <camera_link>camera_link</camera_link>
      <camera_sensor>camera</camera_sensor>
      <mount_mode>upright</mount_mode>
      <command_topic>/two_axis_pod/command</command_topic>
      <telemetry_topic>/two_axis_pod/telemetry</telemetry_topic>
      <command_result_topic>/two_axis_pod/command_result</command_result_topic>
      <control_rate>100</control_rate>
      <telemetry_rate>50</telemetry_rate>
      <max_rate_dps>100</max_rate_dps>
      <max_acc_dps2>160</max_acc_dps2>
      <yaw_min_deg>-90</yaw_min_deg>
      <yaw_max_deg>90</yaw_max_deg>
      <pitch_min_deg>-45</pitch_min_deg>
      <pitch_max_deg>90</pitch_max_deg>
    </plugin>
  </model>
