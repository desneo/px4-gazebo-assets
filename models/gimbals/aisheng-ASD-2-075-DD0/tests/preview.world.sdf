        <image_topic_tele>/aisheng_seeker/camera_tele</image_topic_tele>
        <control_rate>100</control_rate>
        <tracking_backend>sim_truth</tracking_backend>
        <telemetry_config>model://aisheng-ASD-2-075-DD0/controller/service/telemetry.json</telemetry_config>
        <max_rate_dps>60</max_rate_dps>
        <max_acc_dps2>160</max_acc_dps2>
        <servo_kp>4</servo_kp>
        <yaw_min_deg>-60</yaw_min_deg>
        <yaw_max_deg>60</yaw_max_deg>
        <pitch_min_deg>-80</pitch_min_deg>
        <pitch_max_deg>30</pitch_max_deg>
        <los_observer_cg_model>0 0 0</los_observer_cg_model>
        <sim_truth_target_name>target_aircraft</sim_truth_target_name>
        <sim_truth_target_name>target_aircraft_2</sim_truth_target_name>
      </plugin>
